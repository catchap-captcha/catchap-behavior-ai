# Copy outside the repository, for example to /etc/catchap/behavior-ai.env.
# Fill secrets there. Do not commit that file.

# The DB is a separate server, not localhost. Same values the backend already
# uses — the AI has no account of its own (see docs/DB_REQUEST_20260728.md).
MYSQL_HOST=210.109.52.114
MYSQL_PORT=3306
MYSQL_DATABASE=catchap_dev_db
MYSQL_USER=<the backend's DB user>
MYSQL_PASSWORD=<database-secret>
MYSQL_POOL_SIZE=5

# Must equal the main CAPTCHA service's BEHAVIOR_AI_BACKEND_KEY.
CAPTCHA_BACKEND_API_KEY=<long-random-shared-secret>

# Keep admin/collection interfaces disabled unless those callers exist.
ADMIN_API_KEY=
COLLECT_API_KEY=

PRODUCTION_MODEL_DIR=/srv/catchap/ai-service/models/candidate/revalidation_two_view_participant_safe_20260722
RISK_POLICY_MODE=shadow
