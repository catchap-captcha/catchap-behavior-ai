# Copy to .env next to docker-compose.yml on the backend VM, fill in, chmod 600.
# Compose injects these as environment variables; nothing is baked into the image.

# DB is a separate VM. Use the PRIVATE address — the backend already does.
MYSQL_HOST=10.0.1.168
MYSQL_PORT=3306
MYSQL_DATABASE=catchap_dev_db
MYSQL_USER=catchap_backend
MYSQL_PASSWORD=<same as the backend's DATABASE_URL password>
MYSQL_POOL_SIZE=5

# Must equal the CAPTCHA service's BEHAVIOR_AI_BACKEND_KEY. Auth is fail-closed:
# an empty or mismatched value makes every /predict call 401.
CAPTCHA_BACKEND_API_KEY=<long random shared secret>

# Left empty on purpose — /collect and /admin/* stay closed unless those callers exist.
COLLECT_API_KEY=
ADMIN_API_KEY=

# models/production/ is still empty, so point at the candidate bundle explicitly.
# Keep this here, never in a shell variable: on the GPU host the model was chosen
# by an env var on a hand-started process, so a restart silently dropped it.
PRODUCTION_MODEL_DIR=/app/models/candidate/revalidation_two_view_participant_safe_20260722

# Shadow until the false-positive rate is measured against real traffic.
RISK_POLICY_MODE=shadow
