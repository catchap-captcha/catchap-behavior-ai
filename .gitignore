# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node.js tooling
node_modules/

# Env / secrets
.env
*.env
!.env.example

# OS
.DS_Store

# Data — raw/interim/processed contents are never committed (real user data)
data/raw/*
data/interim/*
data/processed/*
data/metadata/*
!data/**/.gitkeep

# Models — trained artifacts are not committed
models/candidate/*
# The model the production container bakes in must be reproducible from the
# repo — infra builds the image from this branch, so an ignored .joblib means
# there is no way to prove the image matches what is running.
!models/candidate/revalidation_two_view_participant_safe_20260722/
!models/candidate/surface_aware_veto_20260810/
models/production/*
!models/**/.gitkeep

# Reports — generated artifacts
reports/*
!reports/.gitkeep

# Training scratch — CV fold arrays, regenerated by train_drag_unit_candidate.py
work/

# Local scratch and generated media
tmp/
output/
models/generative/
