# =========================================================================
# ai-service environment variables (example)
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# The application reads these; it does NOT hardcode any credentials.
# =========================================================================

# --- MySQL 8.0 connection (DB is created/operated by the DB team) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_service
MYSQL_PASSWORD=
MYSQL_DATABASE=catchap
MYSQL_POOL_SIZE=5

# --- Auth (interface only; real secrets injected via env at deploy) ---
# API key that the CAPTCHA backend must send to /collect (X-API-Key header).
COLLECT_API_KEY=
# Admin key required by /admin/* endpoints (X-Admin-Key header).
ADMIN_API_KEY=
# Key used only by the CAPTCHA backend to issue and consume one-time challenges.
# Never expose this to the browser.
CAPTCHA_BACKEND_API_KEY=

# --- CAPTCHA protocol security ---
CAPTCHA_CHALLENGE_TTL_SECONDS=120
CAPTCHA_CHALLENGE_MAX_TTL_SECONDS=300

# --- Model serving ---
# Directory that holds the promoted production model bundle.
PRODUCTION_MODEL_DIR=models/production
# Decision threshold fallback if a bundle does not carry its own threshold.
DEFAULT_THRESHOLD=0.55

# --- Advisory risk policy ---
# These values select a follow-up action only. The CAPTCHA backend remains the
# final decision maker and must never expose its backend key to the browser.
RISK_DTW_SIMILARITY_THRESHOLD=0.996693
RISK_MAX_ATTEMPTS_PER_MINUTE=20
RISK_HISTORY_WINDOW_SECONDS=60
RISK_HISTORY_MAX_ATTEMPTS=50
# shadow: record the AI's recommended action but do not enforce it.
# active: CAPTCHA backend may apply the recommended action after shadow review.
RISK_POLICY_MODE=shadow

# --- Schema versions (bump when the contract changes) ---
API_SCHEMA_VERSION=1.0
FEATURE_SCHEMA_VERSION=1.0

# --- Training readiness gates (project defaults, NOT research thresholds) ---
MIN_HUMAN_SAMPLES=500
MIN_BOT_SAMPLES=500
MIN_HUMAN_PARTICIPANTS=20
MIN_BOT_FAMILIES=3

# --- GAN readiness gates ---
MIN_GAN_HUMAN_SAMPLES=2000
MIN_GAN_HUMAN_PARTICIPANTS=50
